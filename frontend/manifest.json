{
  "manifest_version": 3,
  "name": "Agendify - Smart Agenda Generator",
  "version": "1.0.0",
  "description": "Automatically extract events from your Gmail and sync them with Google Calendar. View today's agenda at a glance.",

  "permissions": [
    "identity",
    "storage",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://gmail.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "oauth2": {
    "client_id": "812025809715-j3n1qe9ddol9tqq7tgepa18jcj2ph707.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Agendify",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
